  auto folder=fbxJob.folder.u8string();FbxEvent("fbx_imported","動畫已重定向並匯入 "+std::to_string(imported)+" 個片段；請至校準區選擇動畫。結果："+std::string(folder.begin(),folder.end()));fbxJob=FbxJob{};
 }catch(const std::exception& e){std::string error=e.what();CancelFbxImport();FbxEvent("fbx_failed",error);}
#endif
}
